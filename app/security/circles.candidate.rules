rules_version = '2';
// MERGED PROTOTYPE: preserves the verified existing private-family rule.
// Models and bounds are documented in CIRCLES-ANALYSIS.md.
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing heterogeneous child/diary/gallery/preferences/task documents.
    // Preserve deployed ownership semantics; no shared Circles roles apply here.
    match /users/{userId}/tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    function signedIn() { return request.auth != null; }
    function text(value, low, high) { return value is string && value.size() >= low && value.size() <= high; }
    function circleExists(cid) { return exists(/databases/$(database)/documents/circles/$(cid)); }
    function owner(cid) { return signedIn() && circleExists(cid) && get(/databases/$(database)/documents/circles/$(cid)).data.ownerUid == request.auth.uid; }
    function member(cid) { return signedIn() && circleExists(cid) && (owner(cid) || exists(/databases/$(database)/documents/circles/$(cid)/members/$(request.auth.uid))); }
    function validCircle(d) {
      return d.keys().hasAll(['name','about','theme','ownerUid','createdAt'])
        && d.keys().hasOnly(['name','about','theme','ownerUid','createdAt'])
        && text(d.name,1,80) && text(d.about,0,500) && d.theme in ['woodland','sky','sunset']
        && text(d.ownerUid,1,128) && d.createdAt is timestamp;
    }
    function validMembership(d, uid) {
      return d.keys().hasAll(['uid','joinedAt']) && d.keys().hasOnly(['uid','joinedAt'])
        && text(d.uid,1,128) && d.uid == uid && d.joinedAt is timestamp;
    }
    function validInvite(d, uid) {
      return d.keys().hasAll(['inviteeUid','createdAt','expiresAt','usedAt'])
        && d.keys().hasOnly(['inviteeUid','createdAt','expiresAt','usedAt'])
        && text(d.inviteeUid,1,128) && d.inviteeUid == uid && d.createdAt is timestamp
        && d.expiresAt is timestamp && d.expiresAt > request.time
        && d.expiresAt <= request.time + duration.value(7,'d')
        && (d.usedAt == null || d.usedAt is timestamp);
    }
    function validEvent(d, cid) {
      return d.keys().hasAll(['circleId','authorUid','authorName','title','body','venue','startsAt','endsAt','costPence','minAge','maxAge','parentStays','kind','status','createdAt'])
        && d.keys().hasOnly(['circleId','authorUid','authorName','title','body','venue','startsAt','endsAt','costPence','minAge','maxAge','parentStays','kind','status','createdAt'])
        && text(d.circleId,1,128) && d.circleId == cid && text(d.authorUid,1,128)
        && text(d.authorName,1,100) && text(d.title,1,120) && text(d.body,0,4000) && text(d.venue,1,200)
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt
        && d.endsAt <= d.startsAt + duration.value(7,'d') && d.createdAt is timestamp
        && d.costPence is int && d.costPence >= 0 && d.costPence <= 100000
        && d.minAge is int && d.maxAge is int && d.minAge >= 0 && d.maxAge <= 18 && d.minAge <= d.maxAge
        && d.parentStays is bool && d.kind in ['organising','attending'] && d.status in ['scheduled','cancelled'];
    }
    match /circles/{cid} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 50;
      allow create: if signedIn() && text(cid,1,128) && validCircle(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if owner(cid) && validCircle(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(cid);
        allow create: if signedIn() && circleExists(cid) && uid == request.auth.uid
          && validMembership(request.resource.data, uid) && request.resource.data.joinedAt == request.time
          && get(/databases/$(database)/documents/circles/$(cid)/invites/$(uid)).data.usedAt == null
          && get(/databases/$(database)/documents/circles/$(cid)/invites/$(uid)).data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/circles/$(cid)/invites/$(uid)).data.usedAt == request.time;
        allow update: if false;
        allow delete: if member(cid) && (owner(cid) || request.auth.uid == uid);
      }
      match /invites/{uid} {
        allow read: if owner(cid) || (signedIn() && circleExists(cid) && request.auth.uid == uid);
        allow create: if owner(cid) && validInvite(request.resource.data, uid)
          && request.resource.data.createdAt == request.time && request.resource.data.usedAt == null;
        allow update: if validInvite(request.resource.data, uid)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.inviteeUid == resource.data.inviteeUid
          && ((owner(cid) && request.resource.data.usedAt == resource.data.usedAt)
            || (signedIn() && request.auth.uid == uid && resource.data.usedAt == null
              && resource.data.expiresAt > request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt'])
              && request.resource.data.usedAt == request.time
              && !exists(/databases/$(database)/documents/circles/$(cid)/members/$(uid))
              && getAfter(/databases/$(database)/documents/circles/$(cid)/members/$(uid)).data.uid == uid));
        allow delete: if owner(cid);
      }
      match /events/{eid} {
        allow read: if member(cid);
        allow create: if member(cid) && validEvent(request.resource.data, cid)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorName == request.auth.token.get('name','Member')
          && request.resource.data.createdAt == request.time && request.resource.data.startsAt >= request.time
          && request.resource.data.status == 'scheduled';
        allow update: if member(cid) && validEvent(request.resource.data, cid)
          && request.resource.data.circleId == resource.data.circleId
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.createdAt == resource.data.createdAt
          && ((request.auth.uid == resource.data.authorUid)
            || (owner(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'cancelled'));
        allow delete: if member(cid) && (owner(cid) || request.auth.uid == resource.data.authorUid);
      }
    }
    match /{path=**} { allow read, write: if false; }
  }
}
